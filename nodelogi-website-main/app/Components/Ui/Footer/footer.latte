{include _assets.latte}

<footer id="footer">
  <img class="footer-img" src="{$baseUrl}/assets/img/footer.svg">
  <div class="footer-text">
    <p>{="footer-heading"|t}</p>
    <h2><span class="footer-pojdme">{="footer-subheading-1"|t}<img class="footer-pojdme-img" src="{$baseUrl}/assets/img/pojdme.svg"></span>{="footer-subheading-2"|t}<span class="footer-znacka">{="footer-subheading-3"|t}<div class="footer-znacka-bck"></div><h2>{="footer-subheading-3"|t}</h2></span></h2>
  </div>
  <div class="footer-bottom">
    <div class="footer-bottom-text">
      <h4>Nodelogi</h4>
      <p>Zábraní 214 Zlín Malenovice <br>+ 420 605 351 086 <br>info@nodelogi.com</p>
    </div>
    <div class="footer-right-side">
      <div class="footer-bottom-buttons">
        <button><a href="https://www.instagram.com/digitalizujeme?utm_source=ig_web_button_share_sheet&igsh=ZDNlZDc0MzIxNw==" target="blank">{="footer-follow-us"|t}</a></button>
        <button onclick="openForm()">{="footer-question-us"|t}</button>
      </div>
      <div class="footer-policy">
        <a>Privacy & Cookie Policy</a>
        <a>Nodelogi © 2024</a>
      </div>
    </div>

  </div>
</footer>