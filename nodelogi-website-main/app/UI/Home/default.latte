                    <div class="projects-wrapper">
                        <h1 class="projects-number">20</h1>
                        <button type="button" class="projects-button">
                            <img style="width: 15.54px; height: 15.54px;" src="{$baseUrl}/assets/img/plus-icon.svg">
                        </button>
                    </div>
                    <div class="text-projects">
                        <p>{="home-subservices-clients"|t}</p>
                    </div>
                </div>
                <div class="text-projects-bottom">
                    <p>{="home-subservices-about"|t|noescape}</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="projects_cards" class="home-reference-container">
    <div class="home-reference-text">
        <h3>{="home-clients-heading"|t}</h3>
        <h4>{="home-clients-subheading"|t}</h4>
    </div>
    <div class="home-reference-wrapper">
        <div class="home-reference-wrapper-left">
            <div class="home-reference-car-wrapper strejda-card">
                <img class="img-strejda-spark" src="{$baseUrl}/assets/img/sparkle.png">
                <div class="reference-card">
                    <img class="reference-card-inside" src="{$baseUrl}/assets/img/strejda-ref.png">
                </div>
                <h3>{="home-clients-card-1-heading"|t}</h3>
                <p>{="home-clients-card-1-description"|t}</p>
            </div>
            <div class="home-reference-car-wrapper">
                <div class="reference-card">
                    <img class="reference-card-inside" src="{$baseUrl}/assets/img/laty-ref.png">
                </div>
                <h3>Latyslav Fitness</h3>
                <p>{="home-clients-card-2-description"|t}</p>
            </div>
        </div>
        <div class="home-reference-wrapper-right">
            <div class="home-reference-car-wrapper">
                <div class="reference-card">
                    <img class="reference-card-inside" src="{$baseUrl}/assets/img/gymfam-ref.png">
                </div>
                <h3>Gymfam</h3>
                <p>{="home-clients-card-3-description"|t}</p>
            </div>
            <div class="home-reference-car-wrapper">
                <div class="reference-card">
                    <div class="random-filler">
                        <img class="reference-card-inside" src="{$baseUrl}/assets/img/soon.svg">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>