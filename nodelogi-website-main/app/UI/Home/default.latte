{block content}
{include _assets.latte}

{control core-emailForm}


<div class="home-landing-page">
    <div class="home-landing-textmessages">
        <button class="home-button-text-message1">
            <p>{="contact"|t}</p>
        </button>
        <button class="home-button-text-message2">
            <p>+420 605 351 086</p>
        </button>
    </div>
    <div class="home-text-container">
        <div class="home-text-main">
            <div class="home-text-main-first">
                <img src="{$baseUrl}/assets/img/Pencil.svg">
                <h2 class="h2wrapper">
                    {="home-landing-main-1"|t|noescape}
                </h2>
            </div>
            <div class="home-text-main-middle-wapper">
                <h2 class="home-text-main-middle">

                    {="home-landing-main-2"|t|noescape}
                    <img src="{$baseUrl}/assets/img/nodelogi-logo-with-shadow.png">
                    {="home-landing-main-3"|t|noescape}
                  
                </h2>
                <img src="{$baseUrl}/assets/img/sparkle.png">
            </div>
            <h2 class="home-text-main-last">
                {="home-landing-main-4"|t|noescape}
            </h2>
            <div class="home-text-arrow-wrapper">
                <img src="{$baseUrl}/assets/img/arrow.png">
                <p>{="home-landing-bottom-text"|t}</p>
            </div>
        </div>
    </div>
    <div class="home-bottom-container">
        <div class="home-bottom-scroll-down">
            <a href="#home_cards">{="home-discover"|t}
                <button class="scroll-down-button">
                    <div class="arrow-holder">
                        <img class="arrow" src="{$baseUrl}/assets/img/arrow-down.svg">
                        <img class="arrow" src="{$baseUrl}/assets/img/arrow-down.svg">
                        <img class="arrow" src="{$baseUrl}/assets/img/arrow-down.svg">
                    </div>
                </button>
            </a>
        </div>
    </div>
    <img class="home-skrr-img" src="{$baseUrl}/assets/img/skrrr.svg">
</div>
<div id="home_cards" class="home-cards-container">
    <div class="home-cards-container-inside">
