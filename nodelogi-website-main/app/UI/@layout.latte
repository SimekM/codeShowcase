<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>{$meta_title}</title>
    <meta content="{$meta_description}" name="description" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta content="" name="keywords" />
   
	<link rel="icon" type="image/x-icon" href="{$baseUrl}/favicon.ico">

    {* No cache params *}
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">

    {include '_assets/_libraries_css.latte'}
    {include '_assets/_main_css.latte'}
 
	{include '_assets/_libraries_js.latte'}


    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
	<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500&family=Poppins:wght@600;700&display=swap"
      rel="stylesheet"
    />
	

   
    <!-- Libraries Stylesheet -->
    <link href="{$baseUrl}/assets/vendor/animate/animate.min.css" rel="stylesheet" />
    <script src="{$baseUrl}/assets/anime.min.js"></script>
    <link href="{$baseUrl}/assets/vendor/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet" />




  </head>
<body>


    <div n:snippet="flash" class="flashMessageContainer">
        {foreach $flashes as $flash}
            <div class="flashMessage {$flash->type}">{$flash->message}</div>
        {/foreach}
    </div>



    {control core-uiNavbar}


    {include content}
     

    {control core-uiFooter}


	{block scripts}
	
	{include '_assets/_main_js.latte'}
 
	
	{/block}
</body>
</html>
